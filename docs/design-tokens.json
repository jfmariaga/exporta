{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Consulta de Aprobaciones LOGGRO — Design Tokens",
    "description": "Tokens extraídos literalmente de tailwind.config.js, resources/css/app.css, resources/js/app.js y los componentes Blade de la aplicación. Los valores marcados \"source: tailwindcss-default\" no están definidos en tailwind.config.js: son los valores por defecto de Tailwind CSS v3.4 (confirmados contra el paquete instalado) que el proyecto usa sin sobreescribir.",
    "generatedFrom": [
      "tailwind.config.js",
      "resources/css/app.css",
      "resources/js/app.js",
      "resources/views/components/*.blade.php",
      "resources/views/layouts/*.blade.php",
      "resources/views/emails/approval-reminder.blade.php",
      "node_modules/tailwindcss (defaultTheme, colors.gray) v3.4.19"
    ]
  },

  "color": {
    "brand": {
      "description": "Rojo/vino institucional Levapan. Fuente: tailwind.config.js theme.extend.colors.brand.",
      "50": "#FBEAEA",
      "100": "#F6D4D4",
      "200": "#EDAAAA",
      "300": "#E27E7E",
      "400": "#DA5E5E",
      "500": "#E24545",
      "600": "#CF1D1D",
      "700": "#A81616",
      "800": "#8E1212",
      "900": "#6E0E0E",
      "950": "#4A0909",
      "usage": {
        "600": "Fondo de botón primario, fondo de enlace/ítem activo del menú lateral, barra de progreso, acentos de texto/enlace (brand-600)",
        "700": "Hover/focus del botón primario",
        "800": "Active del botón primario",
        "500": "Anillo de foco (focus:ring-brand-500)"
      }
    },
    "ink": {
      "description": "Texto. Fuente: tailwind.config.js theme.extend.colors.ink.",
      "default": "#111111",
      "secondary": "#616161",
      "muted": "#3C3C3C"
    },
    "canvas": {
      "description": "Fondo de página (claro/oscuro). Fuente: tailwind.config.js.",
      "default": "#FFFFFF",
      "dark": "#121212"
    },
    "surface": {
      "description": "Fondo de tarjetas/paneles. Fuente: tailwind.config.js.",
      "default": "#FFFFFF",
      "alt": "#F7F4F4",
      "dark": "#1C1C1C"
    },
    "line": {
      "description": "Bordes y separadores en modo claro. Fuente: tailwind.config.js. En modo oscuro se usa white/10 (blanco al 10% de opacidad) en vez de este token.",
      "default": "#EDE8EC"
    },
    "accent": {
      "description": "Acento naranja secundario (poco usado fuera de warning). Fuente: tailwind.config.js.",
      "default": "#E58A45",
      "soft": "#FFD7A7"
    },
    "cold": {
      "description": "Azul frío, usado como fondo del tipo 'info' de <x-alert>. Fuente: tailwind.config.js.",
      "default": "#D5DFF7"
    },
    "success": {
      "description": "Estados aprobados/éxito. Fuente: tailwind.config.js.",
      "default": "#1A7A42",
      "soft": "#E6F4EC",
      "dark": "#2FAE68"
    },
    "warning": {
      "description": "Estados pendientes/advertencia. Fuente: tailwind.config.js. warning.default es igual a accent.default.",
      "default": "#E58A45",
      "soft": "#FDF0E6",
      "text": "#9C5319"
    },
    "danger": {
      "description": "Estados rechazados/error/peligro. Fuente: tailwind.config.js.",
      "default": "#7A1E1E",
      "soft": "#F6E9E9",
      "dark": "#D96E6E",
      "hover": "#5E1717",
      "active": "#431010"
    },
    "neutral": {
      "description": "No están en tailwind.config.js: son la escala 'gray' y black/white por defecto de Tailwind v3, usadas directamente (p. ej. variantes dark:, overlay de modal, menú lateral bg-black). source: tailwindcss-default.",
      "black": "#000000",
      "white": "#FFFFFF",
      "gray": {
        "50": "#f9fafb",
        "100": "#f3f4f6",
        "200": "#e5e7eb",
        "300": "#d1d5db",
        "400": "#9ca3af",
        "500": "#6b7280",
        "600": "#4b5563",
        "700": "#374151",
        "800": "#1f2937",
        "900": "#111827",
        "950": "#030712"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": [
        "Poppins",
        "ui-sans-serif",
        "system-ui",
        "sans-serif",
        "\"Apple Color Emoji\"",
        "\"Segoe UI Emoji\"",
        "\"Segoe UI Symbol\"",
        "\"Noto Color Emoji\""
      ],
      "source": "tailwind.config.js theme.extend.fontFamily.sans = ['Poppins', ...defaultTheme.fontFamily.sans]; aplicada con la clase font-sans en <body>."
    },
    "webFont": {
      "family": "Poppins",
      "weights": [400, 500, 600, 700],
      "provider": "Bunny Fonts (alternativa sin cookies a Google Fonts)",
      "preconnect": "https://fonts.bunny.net",
      "stylesheet": "https://fonts.bunny.net/css?family=poppins:400,500,600,700&display=swap",
      "loadedIn": "resources/views/layouts/app.blade.php y layouts/guest.blade.php, en <head>, vía <link>."
    },
    "fontSize": {
      "description": "Escala por defecto de Tailwind v3 (no personalizada). source: tailwindcss-default.",
      "xs": { "size": "0.75rem", "lineHeight": "1rem" },
      "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "size": "1rem", "lineHeight": "1.5rem" },
      "lg": { "size": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "size": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "size": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "size": "1.875rem", "lineHeight": "2.25rem" }
    },
    "fontWeight": {
      "medium": 500,
      "semibold": 600
    }
  },

  "spacing": {
    "description": "Escala por defecto de Tailwind v3 (no personalizada), subconjunto realmente usado en la interfaz. source: tailwindcss-default.",
    "0": "0px",
    "1": "0.25rem",
    "1.5": "0.375rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "9": "2.25rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "64": "16rem"
  },

  "borderRadius": {
    "description": "Escala completa por defecto de Tailwind v3 (no personalizada). source: tailwindcss-default.",
    "none": "0px",
    "sm": "0.125rem",
    "DEFAULT": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px",
    "usage": {
      "lg": "Botones, inputs, íconos de topbar",
      "3xl": "Tarjetas (<x-card>), tarjeta de login/registro",
      "full": "Badges, barra de progreso, marcador numerado de la línea de tiempo"
    }
  },

  "boxShadow": {
    "description": "Subconjunto realmente usado, valores por defecto de Tailwind v3. source: tailwindcss-default.",
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "usage": {
      "sm": "Tarjetas, botones",
      "lg": "Panel del dropdown (menú de usuario)",
      "xl": "Modal"
    }
  },

  "breakpoints": {
    "description": "Breakpoints por defecto de Tailwind v3 (no personalizados). source: tailwindcss-default.",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "notes": "El quiebre de layout del menú lateral/topbar (off-canvas móvil vs. fijo de escritorio) ocurre en 'lg' (1024px)."
  },

  "darkMode": {
    "strategy": "class",
    "toggleClass": "dark",
    "appliedTo": "<html>",
    "persistence": {
      "storage": "localStorage",
      "key": "theme",
      "values": ["dark", "light"]
    },
    "systemPreferenceFallback": "prefers-color-scheme: dark, cuando no hay valor guardado en localStorage",
    "antiFlickerScript": "Script inline en <head> (antes de @vite) que agrega la clase 'dark' a <html> leyendo localStorage/prefers-color-scheme, para evitar parpadeo antes del primer pintado.",
    "toggleComponent": "x-theme-toggle (resources/views/components/theme-toggle.blade.php)"
  },

  "iconography": {
    "package": "blade-ui-kit/blade-heroicons",
    "version": "^2.7",
    "style": "outline",
    "usagePattern": "<x-heroicon-o-{nombre}> o <x-dynamic-component :component=\"'heroicon-o-'.$icon\">",
    "sizesUsed": ["h-4 w-4", "h-5 w-5", "h-6 w-6", "h-7 w-7", "h-9 w-9"]
  },

  "components": {
    "button.primary": {
      "background": "color.brand.600",
      "backgroundHover": "color.brand.700",
      "backgroundActive": "color.brand.800",
      "text": "color.neutral.white",
      "borderRadius": "borderRadius.lg",
      "paddingX": "spacing.4",
      "paddingY": "spacing.2",
      "fontWeight": "typography.fontWeight.semibold",
      "fontSize": "typography.fontSize.sm",
      "focusRing": "color.brand.500"
    },
    "button.secondary": {
      "background": "color.surface.default",
      "backgroundDark": "color.surface.dark",
      "border": "color.line.default",
      "text": "color.ink.default",
      "backgroundHover": "color.surface.alt",
      "borderRadius": "borderRadius.lg",
      "shadow": "boxShadow.sm"
    },
    "button.danger": {
      "background": "color.danger.default",
      "backgroundHover": "color.danger.hover",
      "backgroundActive": "color.danger.active",
      "text": "color.neutral.white",
      "borderRadius": "borderRadius.lg"
    },
    "badge": {
      "borderRadius": "borderRadius.full",
      "paddingX": "spacing.3.5",
      "paddingY": "spacing.1.5",
      "fontWeight": "typography.fontWeight.semibold",
      "fontSize": "typography.fontSize.sm (sm:fontSize.base)",
      "variants": {
        "success": { "background": "color.success.soft", "text": "color.success.default" },
        "warning": { "background": "color.warning.soft", "text": "color.warning.text" },
        "danger": { "background": "color.danger.soft", "text": "color.danger.default" },
        "brand": { "background": "color.brand.50", "text": "color.brand.700" },
        "gray (default)": { "background": "color.neutral.gray.100", "text": "color.neutral.gray.700" }
      }
    },
    "alert": {
      "borderRadius": "borderRadius.lg",
      "border": "1px solid, color según variante",
      "padding": "spacing.4",
      "variants": {
        "info (default)": { "background": "color.cold.default", "text": "color.ink.default", "border": "color.line.default", "icon": "o-information-circle" },
        "success": { "background": "color.success.soft", "text": "color.success.default", "border": "color.success.default/20", "icon": "o-check-circle" },
        "warning": { "background": "color.warning.soft", "text": "color.warning.text", "border": "color.warning.default/30", "icon": "o-exclamation-triangle" },
        "danger": { "background": "color.danger.soft", "text": "color.danger.default", "border": "color.danger.default/20", "icon": "o-x-circle" }
      }
    },
    "card": {
      "background": "color.surface.default",
      "border": "color.line.default",
      "borderRadius": "borderRadius.3xl",
      "shadow": "boxShadow.sm",
      "padding": "spacing.6"
    },
    "sidebar": {
      "background": "color.neutral.black",
      "widthExpanded": "spacing.64",
      "widthCollapsed": "spacing.20",
      "activeLinkBackground": "color.brand.600",
      "inactiveLinkText": "color.neutral.gray.300",
      "logoAreaBackground": "color.neutral.white"
    },
    "topbar": {
      "height": "spacing.16",
      "background": "color.surface.default",
      "border": "color.line.default"
    }
  },

  "email": {
    "description": "Paleta del correo de recordatorio (resources/views/emails/approval-reminder.blade.php) — mismo sistema de color que la app, pero con estilos en línea porque los clientes de correo no soportan Tailwind ni CSS externo.",
    "maxWidth": "600px",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "pageBackground": "color.surface.alt (#F7F4F4)",
    "cardBackground": "color.surface.default (#FFFFFF)",
    "cardBorder": "color.line.default (#EDE8EC)",
    "headerBackground": "color.neutral.black (#000000)",
    "headerText": "color.neutral.white (#FFFFFF)",
    "textPrimary": "color.ink.default (#111111)",
    "textSecondary": "color.ink.secondary (#616161)",
    "noteModifiedBackground": "color.warning.soft (#FDF0E6)",
    "buttonBackground": "color.brand.600 (#CF1D1D)",
    "buttonText": "color.neutral.white (#FFFFFF)",
    "buttonBorderRadius": "8px",
    "separatorBorder": "color.line.default (#EDE8EC)"
  }
}
